---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME } from '../siteConfig.js';
const pageTitle = SITE_NAME;
---

<Layout title={pageTitle}>
    <div style="display: flex; justify-content: center; align-items: center; min-height: calc(100vh - 60px); padding: 2rem; box-sizing: border-box;">
        <div class="landing-container" style="text-align: center; max-width: 800px;">
            
            <!-- Desktop-only Header Logo -->
            <div class="desktop-landing-logo">
                <img src="/favicon.svg" alt="NyxBug404 Logo" style="width: 150px; height: 150px; object-fit: contain; margin-bottom: 0rem;" />
            </div>

            <h1 style="font-size: 2.2rem; margin-bottom: 0.5rem; font-weight: 500; letter-spacing: 1px;">
                Welcome to the {SITE_NAME} Hub
            </h1>

            <p class="subtitle" style="font-size: 1.1rem; color: #a0a0a0; margin-bottom: 3rem;">
                Select a portal to begin:
            </p>

            <div class="button-grid" style="display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap;">
                <a href="/adults" class="image-button"
                    style="background-image: url('/images/NYXBUG404 Adult Profile Image.png');">
                    <span class="button-label">Adults</span>
                </a>

                <a href="/kids" class="image-button"
                    style="background-image: url('/images/NYXBUG404 Kids Profile Image.png');">
                    <span class="button-label">Kids</span>
                </a>
            </div>
        </div>
    </div>
</Layout>

<style>
    /* Hides the landing page logo on tablet and mobile screens (767px or smaller) */
    @media (max-width: 767px) {
        .desktop-landing-logo {
            display: none !important;
        }
    }
</style>