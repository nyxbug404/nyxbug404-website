			<section id="books">
				<h2>Books & Readers</h2>
				<div class="card-grid">

					<div class="content-card">
						<div class="thumbnail-box"
							style="background-image: url('/images/TheSwingandTheStory_Level_1_Thumbnail.jpg');">
							<span style="display: none;">Level 1 Reader</span>
						</div>
						<h3 class="card-title">
							The Swing and The Story<br>
							<span class="card-subtitle">Level 1 Reader</span>
						</h3>
						<p class="card-text">Follow Maya and Leo's first meeting at the park! A simple, engaging
							beginner
							story introducing big feelings, talking it out, and the start of a wonderful friendship.</p>
						<a href="https://www.amazon.com/dp/B0H7RH5PZ4" target="_blank" class="action-btn">Buy on Amazon
							KDP</a>
					</div>

					<div class="content-card">
						<div class="thumbnail-box"
							style="background-image: url('/images/TheSwingandTheStory_Level_2_Thumbnail.jpg');">
							<span style="display: none;">Level 2 Reader</span>
						</div>
						<h3 class="card-title">
							The Swing and The Story<br>
							<span class="card-subtitle">Level 2 Reader</span>
						</h3>
						<p class="card-text">Maya loves baseball; Leo loves pirate books. When their worlds collide,
							they
							learn how to navigate big emotions, talk it out, and become friends with slightly richer
							sentences.</p>
						<a href="https://www.amazon.com/dp/B0H7RM658F" target="_blank" class="action-btn">Buy on Amazon
							KDP</a>
					</div>



					<div class="content-card">
						<div class="thumbnail-box">
							<svg class="card-icon" width="40" height="40" viewBox="0 0 24 24" fill="none"
								stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
								<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
								<path d="M6 8h2" />
								<path d="M6 12h2" />
								<path d="M16 8h2" />
								<path d="M16 12h2" />
							</svg>
							<span>Coloring Book Coming Soon!</span>
						</div>
						<h3 class="card-title">
							The Swing and The Story<br>
							<span class="card-subtitle">Coloring Book</span>
						</h3>
						<p class="card-text">Meet Maya and Leo! A simple, clutter-free coloring book featuring our
							favorite
							duo showing different emotions, unique traits, and fun holiday themes from Christmas to
							Halloween.</p>
						<span class="action-btn" style="background-color: #222; cursor: default;">Coming Soon to Amazon
							KDP
						</span>
					</div>


					<div class="content-card">
						<div class="thumbnail-box">
							<svg class="card-icon" width="40" height="40" viewBox="0 0 24 24" fill="none"
								stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
								<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
								<path d="M6 8h2" />
								<path d="M6 12h2" />
								<path d="M16 8h2" />
								<path d="M16 12h2" />
							</svg>
							<span>Activity Book Coming Soon!</span>
						</div>
						<h3 class="card-title">
							The Swing and The Story<br>
							<span class="card-subtitle">Activity Book</span>
						</h3>
						<p class="card-text">Packed with mazes, matching games, and puzzles featuring Maya and Leo. A
							fun
							way to boost problem-solving skills and explore big feelings!</p>
						<span class="action-btn" style="background-color: #222; cursor: default;">Coming Soon to Amazon
							KDP</span>
					</div>



