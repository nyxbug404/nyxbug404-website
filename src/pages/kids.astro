	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{pageTitle}</title>
	<link rel="stylesheet" href="style.css">
</head>

<body>
	<header>
		<a href="/" class="back-link">&larr; Back to Hub</a>
		<span style="font-weight: 600; color: #888;">nyxbug404 Kids</span>
	</header>

	<div class="page-shell">
		<aside class="sidebar">
			<div class="sidebar-title">Explore</div>
			<a href="#top">↑ Top of Page</a>
			<a href="#books">Books &amp; Readers</a>
			<a href="#games">Card &amp; Board Games</a>
			<a href="#incogni-tails-jr"
				style="padding: 0.3rem 0 0.3rem 1.5rem; line-height: 1.2; font-size: 0.9rem;">└── Incogni Tails JR</a>
