---
const pageTitle = "nyxbug404 | Adults";
---

<html lang="en">

<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{pageTitle}</title>
	    <link rel="stylesheet" href="/style.css">
	
</head>

<body>
	<header>
		<a href="/" class="back-link">&larr; Back to Hub</a>
		<span style="font-weight: 600; color: #888;">nyxbug404 Adults</span>
	</header>

	<div class="page-shell">
		<aside class="sidebar">
			<div class="sidebar-title">Explore</div>
			<a href="#top">↑ Top of Page</a>
			<a href="#books">Books</a>
			<a href="#games">Card &amp; Board Games</a>
			<a href="#incogni-tails" style="padding: 0.3rem 0 0.3rem 1.5rem; line-height: 1.2; font-size: 0.9rem;">└──
				Incogni Tails</a>
			<a href="#videos">Videos</a>
			<a href="#merch">Merch</a>
			<a href="about.html">About nyxbug404</a>
		</aside>

		<main>
			<section id="adults-zone" class="hero-section">
				<h1>Adults Portal</h1>
				<p class="hero-subtitle">
					Functional daily planners, card games, gameplay videos, and merch built for busy minds and creative organizers. Just practical things designed to help tame the chaos.	
				
				</p>

			</section>

			<nav class="quick-nav">
				<a href="#books" class="quick-nav-item">
					<svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2"
						stroke-linecap="round" stroke-linejoin="round">
						<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
						<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
						<path d="M6 8h2" />
						<path d="M6 12h2" />
						<path d="M16 8h2" />
						<path d="M16 12h2" />
					</svg>

					<span>Books</span>
				</a>
				<a href="#games" class="quick-nav-item">
					<svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2"
						stroke-linecap="round" stroke-linejoin="round">
						<rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
						<path d="M16 8h.01" />
						<path d="M8 8h.01" />
						<path d="M8 16h.01" />
						<path d="M16 16h.01" />
						<path d="M12 12h.01" />
					</svg>
					<span>Games</span>
				</a>
				<a href="#videos" class="quick-nav-item">
					<svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2"
						stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10" />
						<polygon points="10 8 16 12 10 16 10 8" />
					</svg>
					<span>Videos</span>
				</a>
				<a href="#merch" class="quick-nav-item">
					<svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2"
						stroke-linecap="round" stroke-linejoin="round">
						<path
							d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z" />
					</svg>
					<span>Merch</span>
				</a>
			</nav>

			<section id="books">
				<h2>Books</h2>
				<div class="card-grid">

					<div class="content-card">
						<div class="thumbnail-box"
							style="background-image: url('/images/DoodlePlanner_Animals_Volume_1_Thumbnail.jpg');">
							<span style="display: none;">The Doodle Anchor</span>
						</div>
						<h3 class="card-title">
							The Doodle Anchor<br>Organizing Your Day & Mind<br>
							<span class="card-subtitle">Animal Edition Volume 1</span>
						</h3>
						<p class="card-text">Stop the swirling chaos and find your anchor. A functional daily system featuring Morning, Afternoon, and Night blocks, a "Top 3" priority focus, health/symptom tracking, a brain dump, and a daily 3-step animal drawing tutorial with fun facts to reward your routine.</p>
						<a href="https://www.amazon.com/dp/B0GZKJ1Q5Q" target="_blank" class="action-btn">Buy on Amazon
							KDP</a>
					</div>

				</div>
			</section>

			<section id="games">
				<h2>Card & Board Games</h2>


				<h3 id="incogni-tails" class="subsection-title"
					style="color: #fff; margin: 3rem 0 1rem 0; font-size: 1.4rem;">Incogni
					Tails</h3>
				<div class="card-grid">

					<div class="content-card">
						<div class="thumbnail-box"
							style="background-image: url('/images/IncogniTails_Poker_GettingStarted.png');">
							<span style="display: none;">Incogni Tails - Getting Started</span>
						</div>
						<h3 class="card-title">Incogni Tails<br>Getting Started (Poker Size)</h3>
						<p class="card-text">Test your knowledge using 6 visual clues and a bonus fun fact in this
							classic poker-sized guessing game.<br>This deck explores simple, basic animals to get
							everyone playing.</p>
						<a href="https://www.thegamecrafter.com/games/incogni-tails-getting-started" target="_blank"
							class="action-btn">Buy on Game Crafter</a>
					</div>


					<div class="content-card">
						<div class="thumbnail-box"
							style="background-image: url('/images/IncogniTails_Poker_Canada.png');">
							<span style="display: none;">Incogni Tails - Canada</span>
						</div>
						<h3 class="card-title">Incogni Tails<br>Canada (Poker Size)</h3>
						<p class="card-text">Test your knowledge using 6 visual clues and a bonus fun fact in this
							classic poker-sized guessing game.<br>This deck showcases fascinating animals from the
							Canadian wilderness.</p>
						<span class="action-btn" style="background-color: #222; cursor: default;">Coming Soon to Game
							Crafter</span>
					</div>

					<div class="content-card">
						<div class="thumbnail-box"
							style="background-image: url('/images/IncogniTails_Poker_Africa.png');">
							<span style="display: none;">Incogni Tails - Africa</span>
						</div>
						<h3 class="card-title">Incogni Tails<br>Africa (Poker Size)</h3>
						<p class="card-text">Test your knowledge using 6 visual clues and a bonus fun fact in this
							classic poker-sized guessing game.<br>This deck takes you on a safari to discover amazing
							African wildlife.</p>
						<span class="action-btn" style="background-color: #222; cursor: default;">Coming Soon to Game
							Crafter</span>
					</div>

				</div>
			</section>

			<section id="videos">
				<h2>Videos</h2>
				<div class="card-grid">
					<div class="content-card coming-soon">
						<div class="thumbnail-box">
							<svg class="card-icon" width="40" height="40" viewBox="0 0 24 24" fill="none"
								stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<polygon points="10 8 16 12 10 16 10 8" fill="#888"></polygon>
							</svg>
							<span>Video Hub</span>
						</div>
						<h3 class="card-title">Family Gaming</h3>
						<p class="card-text">Watch family PC gameplay directly here without
							leaving
							the page.</p>
						<span class="action-btn" style="background-color: #222; cursor: default;">Coming Soon</span>
					</div>
				</div>
			</section>

			<section id="merch">
				<h2>Merchandise</h2>
				<div class="card-grid">
					<div class="content-card coming-soon">
						<div class="thumbnail-box">
							<svg class="card-icon" width="40" height="40" viewBox="0 0 24 24" fill="none"
								stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path
									d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z">
								</path>
							</svg>
							<span>Character Gear</span>
						</div>
						<h3 class="card-title">Character Shirts & Goods</h3>
						<p class="card-text">Fun, character-themed apparel and items coming down the road.</p>
						<span class="action-btn" style="background-color: #222; cursor: default;">Coming Soon</span>
					</div>
				</div>
			</section>
		</main>
	</div>
</body>

</html>