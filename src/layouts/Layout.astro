---
import { SITE_NAME } from '../siteConfig.js';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="/style.css">
    <title>{title || SITE_NAME}</title>
</head>

<body>

    <header class="mobile-header">
        <a href="/" class="logo">&larr; Hub</a>
        <span class="mobile-page-title">{title || SITE_NAME}</span>
        <button id="menu-toggle" aria-label="Toggle navigation menu">
            ☰
        </button>
    </header>

    <nav id="nav-menu" class="nav-links">
        <a href="/">Home</a>
        <a href="#top">↑ Top of Page</a>
        <a href="#books">Books</a>
        <a href="#games">Games</a>
        <a href="#videos">Videos</a>
        <a href="#merch">Merch</a>
        <a href="about.html">About {SITE_NAME}</a>
    </nav>

    <slot />

    <script>
        const toggleButton = document.getElementById('menu-toggle');
        const navMenu = document.getElementById('nav-menu');

        if (toggleButton && navMenu) {
            // Toggle menu open/closed
            toggleButton.addEventListener('click', () => {
                navMenu.classList.toggle('is-open');
            });

            // Force close the menu immediately when an anchor link is clicked
            const navLinks = navMenu.querySelectorAll('a');
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    setTimeout(() => {
                        navMenu.classList.remove('is-open');
                    }, 50); // 50 millisecond delay ensures it fires reliably
                });
            });
        }
    </script>
</body>

</html>

<style is:global>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        scroll-behavior: smooth;
    }

    /* --- Mobile Navigation Styles --- */
    .mobile-header {
        display: none;
    }

    .nav-links {
        display: none;
    }

    @media (max-width: 767px) {
        .mobile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            z-index: 1000;
            background: #111;
            color: #fff;
            padding: 0rem 1rem;
            box-sizing: border-box;
        }

        .mobile-header .logo {
            color: #fff;
            text-decoration: none;
            font-weight: bold;
        }

        #menu-toggle {
            background: #333;
            color: #fff;
            border: 1px solid #555;
            padding: 0.5rem 0.75rem;
            border-radius: 4px;
            cursor: pointer;
        }

        .nav-links {
            display: none;
            flex-direction: column;
            background: #1a1a1a;
            position: fixed;
            top: 60px;
            left: 0;
            width: 100%;
            box-sizing: border-box;
            border-bottom: 1px solid #333;
            z-index: 999;
            padding: 1rem;
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.5);
        }

        .nav-links.is-open {
            display: flex;
        }

        .nav-links a {
            color: #fff;
            padding: 0.75rem 0;
            text-decoration: none;
        }

        header:not(.mobile-header),
        .content-sub-header {
            margin-top: 60px !important;
        }
    }
</style>